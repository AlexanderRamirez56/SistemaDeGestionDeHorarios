@{
	ViewData["Title"] = "Inicio";
}

<h1 class="text-center mb-4">Sistema de Gestión de Horarios</h1>

<div class="row text-center">

	<div class="col-md-3">
		<div class="card bg-primary text-white mb-3">
			<div class="card-body">
				<h3>@ViewBag.Docentes</h3>
				<p>Docentes</p>
				<a asp-controller="Docentes" asp-action="Index" class="btn btn-light">
					Ir a Docentes
				</a>
			</div>
		</div>
	</div>

	<div class="col-md-3">
		<div class="card bg-success text-white mb-3">
			<div class="card-body">
				<h3>@ViewBag.Asignaturas</h3>
				<p>Asignaturas</p>
				<a asp-controller="Asignaturas" asp-action="Index" class="btn btn-light">
					Ir a Asignaturas
				</a>
			</div>
		</div>
	</div>

	<div class="col-md-3">
		<div class="card bg-warning text-dark mb-3">
			<div class="card-body">
				<h3>@ViewBag.Aulas</h3>
				<p>Aulas</p>
				<a asp-controller="Aulas" asp-action="Index" class="btn btn-dark">
					Ir a Aulas
				</a>
			</div>
		</div>
	</div>

	<div class="col-md-3">
		<div class="card bg-danger text-white mb-3">
			<div class="card-body">
				<h3>@ViewBag.Grupos</h3>
				<p>Grupos</p>
				<a asp-controller="Grupos" asp-action="Index" class="btn btn-light">
					Ir a Grupos
				</a>
			</div>
		</div>
	</div>

</div>

<div class="row text-center">

	<div class="col-md-12">
		<div class="card bg-dark text-white mb-3">
			<div class="card-body">
				<h3>@ViewBag.Horarios</h3>
				<p>Horarios registrados</p>
				<a asp-controller="Horarios" asp-action="Index" class="btn btn-warning">
					Administrar Horarios
				</a>
			</div>
		</div>
	</div>

</div>

